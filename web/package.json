{
    "name": "ferelix-web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "clean": "rimraf dist",
        "preview": "vite preview",
        "lint": "biome lint --write",
        "format": "biome format --write",
        "check": "biome check --write",
        "type-check": "vue-tsc",
        "tc": "vue-tsc",
        "generate-api-types": "openapi-typescript src/api/openapi.json -o src/api/types.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "hls.js": "^1.7.4",
        "openapi-fetch": "^0.17.0",
        "vue": "^3.5.44",
        "vue-i18n": "^11.4.17",
        "vue-router": "^5.4.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.4",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/vue": "^8.1.0",
        "@vitejs/plugin-vue": "^6.0.10",
        "@vitest/coverage-v8": "^5.0.5",
        "@vue/test-utils": "^2.5.1",
        "@vue/typescript-plugin": "^3.3.14",
        "jsdom": "^30.1.3",
        "openapi-typescript": "^7.13.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.9.3",
        "vite": "^8.3.5",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitest": "^5.0.5",
        "vue-tsc": "^3.3.14"
    },
    "engines": {
        "node": ">=26.13.0 <27",
        "pnpm": ">=12.16.1"
    },
    "packageManager": "pnpm@12.16.1"
}
